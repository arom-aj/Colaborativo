<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ejercicio2_A_R.MainPage">

    <VerticalStackLayout
        Padding="30,0"
        Spacing="25"
        VerticalOptions="Center">

        <Label
            x:Name="LblContador"
            Text="10"
            FontSize="80"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="DarkBlue" />

        <Button
            x:Name="BtnIniciar"
            Text="Iniciar cuenta regresiva"
            Clicked="BtnIniciar_Clicked"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>