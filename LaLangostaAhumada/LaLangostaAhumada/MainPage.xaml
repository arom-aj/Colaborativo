<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LaLangostaAhumada"
             x:Class="LaLangostaAhumada.MainPage"
             BackgroundColor="#EAECEE">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Paleta neutra: grises y azul acero como acento -->
            <Color x:Key="ColorPrimario">#34495E</Color>
            <Color x:Key="ColorPrimarioOscuro">#2C3E50</Color>
            <Color x:Key="ColorAcento">#5D6D7E</Color>
            <Color x:Key="ColorFondoTarjeta">#FFFFFF</Color>
            <Color x:Key="ColorFondoPagina">#EAECEE</Color>
            <Color x:Key="ColorTextoOscuro">#212F3C</Color>
            <Color x:Key="ColorTextoGris">#707B7C</Color>
            <Color x:Key="ColorBorde">#D5D8DC</Color>
            <Color x:Key="ColorError">#943126</Color>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource ColorTextoOscuro}" />
                <Setter Property="PlaceholderColor" Value="#95A5A6" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>

            <Style TargetType="Label" x:Key="EtiquetaCampo">
                <Setter Property="TextColor" Value="{StaticResource ColorTextoOscuro}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,40" Spacing="0">

            <!-- Encabezado -->
            <VerticalStackLayout BackgroundColor="{StaticResource ColorPrimario}"
                                  Padding="30,35,30,35"
                                  Spacing="4">
                <Label
                    Text="LA LANGOSTA AHUMADA"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center" />
                <Label
                    Text="Cotizador de Presupuestos para Banquetes"
                    FontSize="14"
                    TextColor="#BFC9CA"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Contenido -->
            <VerticalStackLayout Padding="24,30,24,0" Spacing="22" MaximumWidthRequest="600" HorizontalOptions="Center">

                <!-- Tarjeta: datos de entrada -->
                <Frame BackgroundColor="{StaticResource ColorFondoTarjeta}"
                       CornerRadius="14"
                       Padding="24"
                       HasShadow="True"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="16">

                        <Label Text="Datos del evento"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorPrimario}" />

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorde}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nombre del cliente" Style="{StaticResource EtiquetaCampo}" />
                            <Entry x:Name="EntryNombreCliente"
                                   Placeholder="Ej. Natalia Cruz"
                                   Keyboard="Text"
                                   BackgroundColor="#F4F6F6" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Número de personas" Style="{StaticResource EtiquetaCampo}" />
                            <Entry x:Name="EntryNumeroPersonas"
                                   Placeholder="Ej. 150"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F4F6F6" />
                        </VerticalStackLayout>

                        <Label x:Name="LblError"
                               TextColor="{StaticResource ColorError}"
                               FontSize="13"
                               IsVisible="False" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button
                                Grid.Column="0"
                                x:Name="BtnCalcular"
                                Text="CALCULAR"
                                BackgroundColor="{StaticResource ColorPrimario}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="50"
                                Clicked="BtnCalcular_Clicked" />

                            <Button
                                Grid.Column="1"
                                x:Name="BtnReiniciar"
                                Text="REINICIAR"
                                BackgroundColor="#FFFFFF"
                                TextColor="{StaticResource ColorPrimario}"
                                BorderColor="{StaticResource ColorPrimario}"
                                BorderWidth="1.5"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="50"
                                Clicked="BtnReiniciar_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tarjeta: resultado -->
                <Frame BackgroundColor="{StaticResource ColorFondoTarjeta}"
                       CornerRadius="14"
                       Padding="24"
                       HasShadow="True"
                       BorderColor="{StaticResource ColorAcento}"
                       IsVisible="False"
                       x:Name="FrameResultado">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Resumen de la cotización"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorPrimario}" />

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorde}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Cliente" TextColor="{StaticResource ColorTextoGris}" FontSize="14"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblCliente" TextColor="{StaticResource ColorTextoOscuro}" FontAttributes="Bold" FontSize="14"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="Número de personas" TextColor="{StaticResource ColorTextoGris}" FontSize="14"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblPersonas" TextColor="{StaticResource ColorTextoOscuro}" FontAttributes="Bold" FontSize="14"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="Costo por platillo" TextColor="{StaticResource ColorTextoGris}" FontSize="14"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblCostoUnitario" TextColor="{StaticResource ColorTextoOscuro}" FontAttributes="Bold" FontSize="14"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorde}" Margin="0,6,0,6"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="TOTAL DEL PRESUPUESTO"
                                   TextColor="{StaticResource ColorTextoOscuro}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="LblTotal"
                                   TextColor="{StaticResource ColorPrimario}"
                                   FontAttributes="Bold"
                                   FontSize="24"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tarjeta: historial de cotizaciones -->
                <Frame BackgroundColor="{StaticResource ColorFondoTarjeta}"
                       CornerRadius="14"
                       Padding="24"
                       HasShadow="True"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Cotizaciones anteriores"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource ColorPrimario}" />
                            <Button Grid.Column="1"
                                    x:Name="BtnLimpiarHistorial"
                                    Text="Limpiar"
                                    FontSize="12"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource ColorTextoGris}"
                                    Padding="0"
                                    Clicked="BtnLimpiarHistorial_Clicked" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource ColorBorde}" />

                        <Label x:Name="LblSinHistorial"
                               Text="Aún no hay cotizaciones registradas."
                               TextColor="{StaticResource ColorTextoGris}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               Margin="0,10,0,10" />

                        <CollectionView x:Name="ListaHistorial"
                                        ItemsSource="{Binding HistorialCotizaciones}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Cliente}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{StaticResource ColorTextoOscuro}" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding TotalFormateado}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{StaticResource ColorPrimario}" />
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Detalle}"
                                               FontSize="12"
                                               TextColor="{StaticResource ColorTextoGris}" />
                                        <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                 HeightRequest="1"
                                                 Margin="0,10,0,0"
                                                 BackgroundColor="{StaticResource ColorBorde}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="© 2026 La Langosta Ahumada — Banquetes y Eventos"
                       FontSize="11"
                       TextColor="#909497"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
