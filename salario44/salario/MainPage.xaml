<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="salario.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Calculadora de Sueldo Semanal" FontSize="20" />

        <Label Text="Horas trabajadas en la semana:" />
        <Entry x:Name="EntryHoras" Placeholder="Ej: 40" Keyboard="Numeric" />

        <Label Text="Pago por hora:" />
        <Entry x:Name="EntryPagoPorHora" Placeholder="Ej: 5.50" Keyboard="Numeric" />

        <Button Text="Calcular Sueldo" Clicked="OnCounterClicked" />

        <Label x:Name="LabelResultado" Text="" FontSize="18" />

    </VerticalStackLayout>


</ContentPage>
